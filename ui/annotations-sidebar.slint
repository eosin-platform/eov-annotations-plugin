// The annotations panel (an eov plugin sidebar).
//
// Everything shown comes from properties the plugin pushes (see
// src/sidebar.rs); every action is a callback the plugin handles. Popups
// (menus, choice lists, the colour palette) are drawn inside the panel.

import { Theme } from "theme.slint";
import { Locale } from "locale.slint";

// For tools/ui-check, which checks that `eov-rtl` reaches it.
export { Locale }
import {
    IconButton, TextButton, ButtonFlow, FlowButton, Check, CommitField, PlainField, TextArea, ChoiceButton, Slider,
    Swatch, KeyField, SectionTitle, Hint, Separator, TabButton, ScrollBar,
} from "widgets.slint";

export struct TreeRow {
    id: string,
    layer-id: string,
    // 0 layer, 1 annotation, 2 "show more"
    kind: int,
    label: string,
    detail: string,
    color: color,
    icon: string,
    indent: int,
    selected: bool,
    hovered: bool,
    visible: bool,
    locked: bool,
    collapsed: bool,
    current: bool,
    // 0 draft, 1 verified, 2 rejected
    status: int,
    opacity: float,
    notes: string,
}

export struct KeyValue {
    key: string,
    value: string,
}

export struct ClassRow {
    id: string,
    name: string,
    color: color,
    hotkey: string,
    visible: bool,
    opacity: float,
    count: int,
    active: bool,
    alternate: bool,
    // Why eov refused the hotkey ("" when it works).
    hotkey-note: string,
}

export struct TallyRow {
    name: string,
    color: color,
    count: string,
    density: string,
    per-hpf: string,
}

export struct CommentRow {
    id: string,
    byline: string,
    text: string,
}

// One class compared with another reader ("" lines are left out).
export struct CompareRow {
    name: string,
    color: color,
    points: string,
    regions: string,
}

export struct OrphanRow {
    id: string,
    title: string,
    detail: string,
}

component Label inherits Text {
    horizontal-alignment: Locale.start;
    font-size: Theme.font-size;
    color: Theme.text-secondary;
    vertical-alignment: center;
    min-width: 64px;
    horizontal-stretch: 0;
}

// One row of the layer/annotation list.
component TreeItem inherits Rectangle {
    in property <TreeRow> item;
    in property <bool> editable;
    in property <bool> editing;
    callback clicked(bool /* additive */);
    callback double-clicked();
    callback hover-changed(bool);
    callback toggle-collapsed();
    callback toggle-visible();
    callback toggle-locked();
    callback toggle-editor();

    property <bool> additive;

    height: 24px;
    background: root.item.selected ? Theme.selection : (root.item.hovered || touch.has-hover) ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.item.label;
    // Translators: read out for the layer new annotations go into; {} is its number of annotations.
    accessible-description: root.item.kind == 0 && root.item.current ? @tr("{} · new annotations go here", root.item.detail) : root.item.detail;
    accessible-item-selectable: root.item.kind == 1;
    accessible-item-selected: root.item.selected;
    accessible-expandable: root.item.kind == 0;
    accessible-expanded: !root.item.collapsed;
    accessible-action-default => {
        root.clicked(false);
    }
    accessible-action-expand => {
        root.toggle-collapsed();
    }

    // The layer new annotations go into.
    if root.item.kind == 0 && root.item.current: Rectangle {
        x: 0px;
        width: 3px;
        background: Theme.accent-text;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.additive = event.modifiers.control || event.modifiers.meta || event.modifiers.shift;
            }
        }
        clicked => {
            root.clicked(root.additive);
        }
        double-clicked => {
            root.double-clicked();
        }
        changed has-hover => {
            root.hover-changed(self.has-hover);
        }
    }

    // Layer rows.
    if root.item.kind == 0: HorizontalLayout {
        padding-left: 2px;
        padding-right: 4px;
        spacing: 4px;

        IconButton {
            width: 20px;
            icon: root.item.collapsed ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-down.svg");
            label: root.item.collapsed ? @tr("Expand layer") : @tr("Collapse layer");
            tint: Theme.text-secondary;
            clicked => {
                root.toggle-collapsed();
            }
        }

        Rectangle {
            width: 10px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                border-radius: 2px;
                background: root.item.color;
                opacity: root.item.visible ? 1 : 0.35;
            }
        }

        Text {
            text: root.item.label;
            font-size: Theme.font-size;
            font-weight: root.item.current ? 700 : 500;
            color: root.item.visible ? Theme.text-primary : Theme.text-disabled;
            horizontal-alignment: Locale.start;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.item.detail;
            font-size: Theme.small-font-size;
            color: Theme.text-secondary;
            horizontal-alignment: Locale.end;
            vertical-alignment: center;
            overflow: elide;
            max-width: 110px;
        }

        IconButton {
            icon: root.item.visible ? @image-url("icons/eye.svg") : @image-url("icons/eye-off.svg");
            label: root.item.visible ? @tr("Hide layer") : @tr("Show layer");
            tint: root.item.visible ? Theme.text-primary : Theme.text-disabled;
            clicked => {
                root.toggle-visible();
            }
        }

        IconButton {
            icon: root.item.locked ? @image-url("icons/lock.svg") : @image-url("icons/unlock.svg");
            label: root.item.locked ? @tr("Unlock layer") : @tr("Lock layer");
            enabled: root.editable;
            tint: root.item.locked ? Theme.warning : Theme.text-disabled;
            clicked => {
                root.toggle-locked();
            }
        }

        IconButton {
            icon: @image-url("icons/more.svg");
            label: @tr("Layer settings");
            active: root.editing;
            clicked => {
                root.toggle-editor();
            }
        }
    }

    // Annotation rows.
    if root.item.kind == 1: HorizontalLayout {
        padding-left: 30px;
        padding-right: 8px;
        spacing: 6px;

        Rectangle {
            width: 8px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.item.color;
                opacity: root.item.visible ? 1 : 0.35;
            }
        }

        Text {
            width: 14px;
            text: root.item.icon;
            font-size: Theme.font-size;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            text: root.item.label;
            font-size: Theme.font-size;
            color: root.item.visible ? Theme.text-primary : Theme.text-disabled;
            horizontal-alignment: Locale.start;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.item.detail;
            font-size: Theme.small-font-size;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-alignment: Locale.end;
            overflow: elide;
            max-width: 130px;
        }

        if root.item.status != 0: Text {
            text: root.item.status == 1 ? "✓" : "✗";
            font-size: Theme.font-size;
            color: root.item.status == 1 ? Theme.success : Theme.error;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: root.item.status == 1 ? @tr("Review status" => "Verified") : @tr("Review status" => "Rejected");
        }

        if root.item.locked: Image {
            width: 12px;
            source: @image-url("icons/lock.svg");
            colorize: Theme.text-secondary;
            accessible-role: image;
            accessible-label: @tr("Locked");
        }
    }

    // "Show more".
    if root.item.kind == 2: Text {
        x: 30px;
        width: parent.width - 38px;
        text: root.item.label;
        font-size: Theme.font-size;
        color: touch.has-hover ? Theme.accent-hover : Theme.accent-text;
        horizontal-alignment: Locale.start;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AnnotationsSidebar inherits Rectangle {
    // ---------------------------------------------------------------
    // Pushed by the plugin.
    // ---------------------------------------------------------------
    in-out property <int> tab: 0;
    in property <string> slide-title: @tr("No slide open");
    in property <string> banner;
    // 0 info, 1 warning, 2 error
    in property <int> banner-level;
    in property <bool> banner-retry;
    in property <bool> editable;
    in property <bool> has-slide;
    in property <[string]> class-names: [@tr("Unclassified")];

    in property <[TreeRow]> rows;
    in property <string> rows-note;
    in property <string> filter;
    in property <[string]> layer-names;

    in property <int> selection-count;
    in property <bool> has-detail;
    in property <string> detail-id;
    in property <string> detail-title;
    in property <string> detail-kind;
    in property <string> detail-name;
    in property <string> detail-description;
    in property <int> detail-class;
    in property <int> detail-status;
    in property <int> detail-layer;
    in property <bool> detail-locked;
    in property <string> detail-meta;
    in property <string> detail-warning;
    in property <[KeyValue]> detail-measurements;
    in property <[KeyValue]> detail-properties;
    in property <[CommentRow]> detail-comments;

    in property <[ClassRow]> classes;

    in property <int> count-active-index;
    in property <int> count-alternate-index;
    in property <int> count-immune-index;
    in property <[TallyRow]> tally;
    in property <string> count-scope;
    in property <string> count-index;
    in property <int> field-count;
    in property <bool> count-hidden;
    in property <string> field-text;
    // 0 field number and objective, 1 area
    in property <int> field-mode;
    in property <string> field-number: "22";
    in property <string> field-objective: "40";
    in property <string> field-area;

    // The comparison with another reader ("" title: none).
    in property <string> compare-title;
    in property <string> compare-note;
    in property <[CompareRow]> compare-rows;

    in property <string> db-path;
    in property <string> db-status;
    in property <string> db-notes;
    // The pre-1.0 database found in eov's old settings folder ("" if none).
    in property <string> legacy-db;
    in property <[OrphanRow]> orphans;
    in property <string> orphans-note;
    in property <string> setting-author;
    in property <string> setting-organization;
    in property <string> setting-project;
    in property <string> setting-license;
    in property <bool> setting-include-filename;
    in property <float> setting-point-radius: 4.5;
    in property <float> setting-fill-opacity: 0.18;
    in property <bool> setting-show-labels;
    in property <float> setting-brush-size: 24;
    in property <bool> setting-brush-eraser;

    // ---------------------------------------------------------------
    // Set by eov.
    // ---------------------------------------------------------------
    // The interface is written from right to left.
    in-out property <bool> eov-rtl <=> Locale.rtl;
    // The language of the interface (a tag such as "pt-BR"). An open menu
    // or list closes when it changes: its items are copies, in the language
    // they were opened in.
    in property <string> eov-language;
    changed eov-language => {
        Locale.language = root.eov-language;
        root.popup = 0;
    }

    // ---------------------------------------------------------------
    // Handled by the plugin.
    // ---------------------------------------------------------------
    callback tab-changed(int);
    callback retry();
    callback menu(string /* item */);
    callback tool(string /* tool id */);

    callback filter-edited(string);
    callback show-more();
    callback row-clicked(string /* id */, string /* layer id */, bool /* additive */);
    callback row-double-clicked(string /* id */, string /* layer id */);
    callback row-hovered(string /* id, or "" */);
    callback toggle-collapsed(string /* layer id */);

    callback layer-new();
    callback layer-visible(string, bool);
    callback layer-locked(string, bool);
    callback layer-opacity(string, float);
    callback layer-color(string, string /* #rrggbb */);
    callback layer-rename(string, string);
    callback layer-notes(string, string);
    callback layer-current(string);
    callback layer-delete(string);

    callback detail-name-committed(string /* owner */, string);
    callback detail-description-committed(string /* owner */, string);
    callback detail-class-chosen(int /* index in class-names */);
    callback detail-status-chosen(int);
    callback detail-layer-chosen(int /* index in layer-names */);
    callback detail-locked-toggled(bool);
    callback detail-delete();
    callback detail-frame();
    callback detail-repair();
    callback copy-measurements();
    callback comment-add(string /* owner */, string /* text */);
    callback comment-remove(string /* owner */, string /* comment id */);
    callback property-add(string /* owner */);
    callback property-remove(string /* owner */, int /* row */);
    callback property-committed(string /* owner */, int /* row */, string /* key */, string /* value */);

    callback class-new();
    callback class-activate(string);
    callback class-alternate(string);
    callback class-rename(string, string);
    callback class-color(string, string /* #rrggbb */);
    callback class-hotkey(string, string);
    callback class-visible(string, bool);
    callback class-opacity(string, float);
    callback class-delete(string);

    callback count-active(int /* index in class-names */);
    callback count-alternate(int /* index in class-names */);
    callback count-immune(int /* index in class-names */);
    callback count-hidden-toggled(bool);
    callback count-clear();
    callback fields-select();
    callback field-config(int /* mode */, string /* field number */, string /* objective */, string /* area */);

    callback orphans-refresh();
    callback legacy-merge();
    callback orphan-relink(string);
    callback setting-text(string /* key */, string);
    callback setting-bool(string /* key */, bool);
    callback setting-number(string /* key */, float);

    // ---------------------------------------------------------------
    // Local state.
    // ---------------------------------------------------------------
    property <string> editing-layer;
    property <string> editing-class;
    property <string> hovered-row;
    property <int> local-field-mode: root.field-mode;

    // Popups: 0 none, 1 list, 2 palette.
    property <int> popup: 0;
    property <string> popup-target;
    property <string> popup-owner;
    property <[string]> popup-items;
    property <int> popup-current: -1;
    property <length> popup-x;
    property <length> popup-y;
    // The list's least width; it is as wide as its widest item, within the
    // panel.
    property <length> popup-w;
    // `popup-x` is where the list ends (the menu), not where it starts.
    property <bool> popup-x-is-end;

    property <[string]> menu-labels: [
        @tr("Import annotations…"),
        @tr("Export as GeoJSON (QuPath)…"),
        @tr("Export as eov JSON…"),
        @tr("Export as ASAP XML…"),
        @tr("Export as ImageScope XML…"),
        @tr("Export as DICOM annotations…"),
        @tr("Export measurements (CSV)…"),
        @tr("Export a blinded copy…"),
        @tr("Compare with another reader…"),
        @tr("Export all slides…"),
        @tr("Back up the database…"),
        @tr("Merge a database…"),
    ];
    property <[string]> menu-ids: [
        "import",
        "export-geojson",
        "export-eov",
        "export-asap",
        "export-imagescope",
        "export-dicom",
        "export-csv",
        "export-blinded",
        "compare",
        "export-all",
        "backup",
        "merge-db",
    ];
    property <[string]> status-names: [@tr("Review status" => "Draft"), @tr("Review status" => "Verified"), @tr("Review status" => "Rejected")];
    property <[string]> field-modes: [@tr("Field number and objective"), @tr("Field area")];
    property <[{hex: string, color: color}]> palette: [
        { hex: "#E69F00", color: #E69F00 },
        { hex: "#56B4E9", color: #56B4E9 },
        { hex: "#009E73", color: #009E73 },
        { hex: "#F0E442", color: #F0E442 },
        { hex: "#0072B2", color: #0072B2 },
        { hex: "#D55E00", color: #D55E00 },
        { hex: "#CC79A7", color: #CC79A7 },
        { hex: "#FFFFFF", color: #FFFFFF },
        { hex: "#FF355E", color: #FF355E },
        { hex: "#39FF14", color: #39FF14 },
        { hex: "#9D4EDD", color: #9D4EDD },
        { hex: "#43AA8B", color: #43AA8B },
        { hex: "#FF8A5B", color: #FF8A5B },
        { hex: "#B8F2E6", color: #B8F2E6 },
        { hex: "#577590", color: #577590 },
        { hex: "#F4A261", color: #F4A261 },
    ];

    function open-list(target: string, items: [string], current: int, x: length, y: length, w: length) {
        root.popup-target = target;
        root.popup-items = items;
        root.popup-current = current;
        root.popup-x = x - root.absolute-position.x;
        root.popup-y = y - root.absolute-position.y;
        root.popup-w = w;
        root.popup-x-is-end = false;
        root.popup = 1;
    }

    // The import and export menu, under the button and ending where it ends.
    function open-menu(end-x: length, y: length) {
        root.open-list("menu", root.menu-labels, -1, end-x, y, 230px);
        root.popup-x-is-end = true;
    }

    function open-palette(target: string, owner: string, x: length, y: length) {
        root.popup-target = target;
        root.popup-owner = owner;
        root.popup-x = x - root.absolute-position.x;
        root.popup-y = y - root.absolute-position.y;
        root.popup-w = 0px;
        root.popup = 2;
    }

    function choose(index: int) {
        root.popup = 0;
        if root.popup-target == "menu" {
            root.menu(root.menu-ids[index]);
        } else if root.popup-target == "detail-class" {
            root.detail-class-chosen(index);
        } else if root.popup-target == "detail-status" {
            root.detail-status-chosen(index);
        } else if root.popup-target == "detail-layer" {
            root.detail-layer-chosen(index);
        } else if root.popup-target == "count-active" {
            root.count-active(index);
        } else if root.popup-target == "count-alternate" {
            root.count-alternate(index);
        } else if root.popup-target == "count-immune" {
            root.count-immune(index);
        } else if root.popup-target == "field-mode" {
            root.local-field-mode = index;
        }
    }

    function pick-color(hex: string) {
        root.popup = 0;
        if root.popup-target == "layer" {
            root.layer-color(root.popup-owner, hex);
        } else if root.popup-target == "class" {
            root.class-color(root.popup-owner, hex);
        }
    }

    function select-tab(index: int) {
        root.popup = 0;
        root.tab = index;
        root.tab-changed(index);
    }

    background: Theme.surface;
    accessible-role: complementary;
    accessible-label: @tr("Annotations");

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.width - 1px;
        height: root.height;
        spacing: 0px;

        // -----------------------------------------------------------
        // Header.
        // -----------------------------------------------------------
        VerticalLayout {
            padding-left: 10px;
            padding-right: 6px;
            padding-top: 8px;
            padding-bottom: 6px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 4px;

                Text {
                    text: root.slide-title;
                    font-size: 13px;
                    font-weight: 600;
                    color: root.has-slide ? Theme.text-primary : Theme.text-secondary;
                    horizontal-alignment: Locale.start;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                menu-button := IconButton {
                    icon: @image-url("icons/more.svg");
                    label: @tr("Import and export");
                    active: root.popup == 1 && root.popup-target == "menu";
                    clicked => {
                        root.open-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height);
                    }
                }
            }

            if root.banner != "": Rectangle {
                border-radius: 4px;
                background: root.banner-level == 2 ? Theme.error-surface : root.banner-level == 1 ? Theme.warning-surface : Theme.info-surface;
                accessible-role: text;
                accessible-label: root.banner;

                // Wrapped text only in vertical layouts: Slint sizes it
                // correctly there.
                VerticalLayout {
                    padding: 6px;
                    spacing: 6px;

                    Text {
                        text: root.banner;
                        horizontal-alignment: Locale.start;
                        font-size: Theme.font-size;
                        color: root.banner-level == 2 ? #ffb4ab : root.banner-level == 1 ? #ffd88a : Theme.text-primary;
                        wrap: word-wrap;
                        height: self.preferred-height;
                    }

                    if root.banner-retry: HorizontalLayout {
                        alignment: end;

                        TextButton {
                            text: @tr("Retry");
                            clicked => {
                                root.retry();
                            }
                        }
                    }
                }
            }
        }

        // Tabs.
        HorizontalLayout {
            accessible-role: tab-list;

            TabButton {
                text: @tr("Layers");
                selected: root.tab == 0;
                clicked => {
                    root.select-tab(0);
                }
            }

            TabButton {
                text: @tr("Classes");
                selected: root.tab == 1;
                clicked => {
                    root.select-tab(1);
                }
            }

            TabButton {
                // Translators: the tab for counting cells.
                text: @tr("Count");
                selected: root.tab == 2;
                clicked => {
                    root.select-tab(2);
                }
            }

            TabButton {
                text: @tr("Data");
                selected: root.tab == 3;
                clicked => {
                    root.select-tab(3);
                }
            }
        }

        Separator { }

        // -----------------------------------------------------------
        // Tab contents.
        // -----------------------------------------------------------
        content := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // ---------------- Layers ----------------
            if root.tab == 0: VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding: 8px;
                    padding-bottom: 6px;
                    spacing: 6px;

                    Rectangle {
                        height: 24px;
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: filter-input.has-focus ? Theme.accent : Theme.border;
                        background: Theme.input;
                        clip: true;

                        if filter-input.text == "" && !filter-input.has-focus: Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: @tr("Filter by name, class, kind or status");
                            color: Theme.text-disabled;
                            font-size: Theme.font-size;
                            horizontal-alignment: Locale.start;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        filter-input := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: root.filter;
                            single-line: true;
                            horizontal-alignment: Locale.start;
                            vertical-alignment: center;
                            font-size: Theme.font-size;
                            color: Theme.text-primary;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: #ffffff;
                            text-cursor-width: 1px;
                            accessible-role: text-input;
                            accessible-label: @tr("Filter annotations");
                            edited => {
                                root.filter-edited(self.text);
                            }
                            key-pressed(event) => {
                                if event.text == Key.Escape && self.text != "" {
                                    self.text = "";
                                    root.filter-edited("");
                                    return accept;
                                }
                                reject
                            }
                        }
                    }

                    IconButton {
                        icon: @image-url("icons/plus.svg");
                        label: @tr("New layer");
                        enabled: root.editable;
                        clicked => {
                            root.layer-new();
                        }
                    }
                }

                // The list.
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 96px;

                    list := Flickable {
                        content-width: self.width;
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;

                        VerticalLayout {
                            alignment: start;
                            spacing: 0px;
                            padding-bottom: 6px;

                            for row in root.rows: VerticalLayout {
                                TreeItem {
                                    item: row;
                                    editable: root.editable;
                                    editing: row.kind == 0 && root.editing-layer == row.id;
                                    clicked(additive) => {
                                        if row.kind == 2 {
                                            root.show-more();
                                        } else {
                                            root.row-clicked(row.id, row.layer-id, additive);
                                        }
                                    }
                                    double-clicked => {
                                        if row.kind == 0 {
                                            root.editing-layer = root.editing-layer == row.id ? "" : row.id;
                                        } else if row.kind == 1 {
                                            root.row-double-clicked(row.id, row.layer-id);
                                        }
                                    }
                                    hover-changed(hovered) => {
                                        if row.kind == 1 {
                                            if hovered {
                                                root.hovered-row = row.id;
                                                root.row-hovered(row.id);
                                            } else if root.hovered-row == row.id {
                                                root.hovered-row = "";
                                                root.row-hovered("");
                                            }
                                        }
                                    }
                                    toggle-collapsed => {
                                        root.toggle-collapsed(row.id);
                                    }
                                    toggle-visible => {
                                        root.layer-visible(row.id, !row.visible);
                                    }
                                    toggle-locked => {
                                        root.layer-locked(row.id, !row.locked);
                                    }
                                    toggle-editor => {
                                        root.editing-layer = root.editing-layer == row.id ? "" : row.id;
                                    }
                                }

                                // Layer settings, under the layer's row.
                                if row.kind == 0 && root.editing-layer == row.id: Rectangle {
                                    background: Theme.surface-raised;

                                    VerticalLayout {
                                        padding-left: 28px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 8px;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Label {
                                                text: @tr("Name");
                                            }

                                            CommitField {
                                                owner: row.id;
                                                value: row.label;
                                                placeholder: @tr("Layer name");
                                                enabled: root.editable;
                                                accessible-label: @tr("Layer name");
                                                committed(owner, text) => {
                                                    root.layer-rename(owner, text);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Label {
                                                text: @tr("Colour");
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                Swatch {
                                                    fill: row.color;
                                                    enabled: root.editable;
                                                    label: @tr("Layer colour");
                                                    clicked(x, y) => {
                                                        root.open-palette("layer", row.id, x, y);
                                                    }
                                                }
                                            }

                                            Label {
                                                text: @tr("Opacity");
                                                min-width: 0px;
                                            }

                                            Slider {
                                                value: row.opacity;
                                                label: @tr("Layer opacity");
                                                released(value) => {
                                                    root.layer-opacity(row.id, value);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Label {
                                                text: @tr("Notes");
                                                vertical-alignment: top;
                                            }

                                            CommitField {
                                                owner: row.id;
                                                value: row.notes;
                                                multiline: true;
                                                placeholder: @tr("Notes about this layer");
                                                enabled: root.editable;
                                                accessible-label: @tr("Layer notes");
                                                committed(owner, text) => {
                                                    root.layer-notes(owner, text);
                                                }
                                            }
                                        }

                                        ButtonFlow {
                                            property <FlowButton> draw-button: { text: @tr("Draw into this layer"), enabled: root.editable, primary: false, danger: false };
                                            property <FlowButton> delete-button: { text: @tr("Delete layer…"), enabled: root.editable, primary: false, danger: true };

                                            align-end: true;
                                            // "Draw into this layer" unless it is the layer drawn into.
                                            buttons: row.current ? [self.delete-button] : [self.draw-button, self.delete-button];
                                            clicked(index) => {
                                                if !row.current && index == 0 {
                                                    root.layer-current(row.id);
                                                } else {
                                                    root.editing-layer = "";
                                                    root.layer-delete(row.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.rows-note != "": VerticalLayout {
                                padding: 10px;

                                Hint {
                                    text: root.rows-note;
                                    accessible-role: text;
                                }
                            }
                        }
                    }

                    ScrollBar {
                        x: parent.width - self.width;
                        y: 0px;
                        height: parent.height;
                        content-height: list.content-height;
                        view-height: list.height;
                        offset: -list.content-y;
                        scrolled(offset) => {
                            list.content-y = -offset;
                        }
                    }
                }

                // Details of the selection.
                if root.has-detail: VerticalLayout {
                    Separator { }

                    Rectangle {
                        height: min(details.preferred-height, max(150px, content.height * 0.55));

                        detail-flick := Flickable {
                            content-width: self.width;
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;

                            details := VerticalLayout {
                                alignment: start;
                                padding: 10px;
                                padding-right: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 2px;

                                    Text {
                                        text: root.detail-title;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        horizontal-alignment: Locale.start;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    IconButton {
                                        icon: @image-url("icons/frame.svg");
                                        label: @tr("Zoom to the annotation");
                                        clicked => {
                                            root.detail-frame();
                                        }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/copy.svg");
                                        label: @tr("Copy measurements");
                                        clicked => {
                                            root.copy-measurements();
                                        }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/trash.svg");
                                        label: root.selection-count > 1 ? @tr("Delete the selected annotations") : @tr("Delete the annotation");
                                        enabled: root.editable && !root.detail-locked;
                                        clicked => {
                                            root.detail-delete();
                                        }
                                    }
                                }

                                if root.detail-warning != "": Rectangle {
                                    border-radius: 4px;
                                    background: Theme.warning-surface;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 6px;

                                        Text {
                                            text: root.detail-warning;
                                            font-size: Theme.small-font-size;
                                            color: #ffd88a;
                                            horizontal-alignment: Locale.start;
                                            wrap: word-wrap;
                                            height: self.preferred-height;
                                        }

                                        HorizontalLayout {
                                            alignment: end;

                                            TextButton {
                                                text: @tr("Repair");
                                                enabled: root.editable;
                                                clicked => {
                                                    root.detail-repair();
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.selection-count == 1: HorizontalLayout {
                                    spacing: 6px;

                                    Label {
                                        text: @tr("Name");
                                    }

                                    CommitField {
                                        owner: root.detail-id;
                                        value: root.detail-name;
                                        placeholder: @tr("Unnamed");
                                        enabled: root.editable && !root.detail-locked;
                                        accessible-label: @tr("Annotation name");
                                        committed(owner, text) => {
                                            root.detail-name-committed(owner, text);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Label {
                                        text: @tr("Class");
                                    }

                                    ChoiceButton {
                                        text: root.class-names[root.detail-class];
                                        enabled: root.editable && !root.detail-locked;
                                        accessible-label: @tr("Annotation class");
                                        open(x, y, w) => {
                                            root.open-list("detail-class", root.class-names, root.detail-class, x, y, w);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Label {
                                        text: @tr("Status");
                                    }

                                    ChoiceButton {
                                        text: root.status-names[root.detail-status];
                                        enabled: root.editable && !root.detail-locked;
                                        accessible-label: @tr("Review status");
                                        open(x, y, w) => {
                                            root.open-list("detail-status", root.status-names, root.detail-status, x, y, w);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Label {
                                        text: @tr("Layer");
                                    }

                                    ChoiceButton {
                                        text: root.layer-names[root.detail-layer];
                                        enabled: root.editable && !root.detail-locked;
                                        accessible-label: @tr("Annotation layer");
                                        open(x, y, w) => {
                                            root.open-list("detail-layer", root.layer-names, root.detail-layer, x, y, w);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 70px;

                                    Check {
                                        text: @tr("Locked");
                                        checked: root.detail-locked;
                                        enabled: root.editable;
                                        toggled(locked) => {
                                            root.detail-locked-toggled(locked);
                                        }
                                    }
                                }

                                if root.selection-count == 1: HorizontalLayout {
                                    spacing: 6px;

                                    Label {
                                        text: @tr("Notes");
                                        vertical-alignment: top;
                                    }

                                    CommitField {
                                        owner: root.detail-id;
                                        value: root.detail-description;
                                        multiline: true;
                                        placeholder: @tr("Description");
                                        enabled: root.editable && !root.detail-locked;
                                        accessible-label: @tr("Description");
                                        committed(owner, text) => {
                                            root.detail-description-committed(owner, text);
                                        }
                                    }
                                }

                                if root.detail-measurements.length > 0: VerticalLayout {
                                    spacing: 2px;

                                    SectionTitle {
                                        text: @tr("MEASUREMENTS");
                                    }

                                    for m in root.detail-measurements: HorizontalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: m.key;
                                            font-size: Theme.font-size;
                                            color: Theme.text-secondary;
                                            horizontal-alignment: Locale.start;
                                            min-width: 96px;
                                            horizontal-stretch: 0;
                                        }

                                        Text {
                                            text: m.value;
                                            font-size: Theme.font-size;
                                            color: Theme.text-primary;
                                            horizontal-alignment: Locale.start;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                if root.selection-count == 1: VerticalLayout {
                                    spacing: 4px;

                                    SectionTitle {
                                        text: @tr("PROPERTIES");
                                    }

                                    for kv[i] in root.detail-properties: HorizontalLayout {
                                        spacing: 4px;

                                        CommitField {
                                            owner: root.detail-id;
                                            value: kv.key;
                                            placeholder: @tr("Name");
                                            enabled: root.editable && !root.detail-locked;
                                            accessible-label: @tr("Property name");
                                            committed(owner, text) => {
                                                root.property-committed(owner, i, text, kv.value);
                                            }
                                        }

                                        CommitField {
                                            owner: root.detail-id;
                                            value: kv.value;
                                            placeholder: @tr("Value");
                                            enabled: root.editable && !root.detail-locked;
                                            accessible-label: @tr("Property value");
                                            committed(owner, text) => {
                                                root.property-committed(owner, i, kv.key, text);
                                            }
                                        }

                                        IconButton {
                                            icon: @image-url("icons/trash.svg");
                                            label: @tr("Remove property");
                                            enabled: root.editable && !root.detail-locked;
                                            clicked => {
                                                root.property-remove(root.detail-id, i);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: start;

                                        TextButton {
                                            text: @tr("Add property");
                                            enabled: root.editable && !root.detail-locked;
                                            clicked => {
                                                root.property-add(root.detail-id);
                                            }
                                        }
                                    }
                                }

                                if root.selection-count == 1: VerticalLayout {
                                    spacing: 4px;

                                    SectionTitle {
                                        text: root.detail-comments.length == 0 ? @tr("COMMENTS") : @tr("COMMENTS ({})", root.detail-comments.length);
                                    }

                                    for c in root.detail-comments: Rectangle {
                                        border-radius: 4px;
                                        background: Theme.surface-raised;

                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 2px;

                                            HorizontalLayout {
                                                spacing: 4px;

                                                Text {
                                                    text: c.byline;
                                                    font-size: Theme.small-font-size;
                                                    color: Theme.text-secondary;
                                                    horizontal-alignment: Locale.start;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }

                                                IconButton {
                                                    icon: @image-url("icons/trash.svg");
                                                    label: @tr("Delete comment");
                                                    enabled: root.editable;
                                                    clicked => {
                                                        root.comment-remove(root.detail-id, c.id);
                                                    }
                                                }
                                            }

                                            Text {
                                                text: c.text;
                                                font-size: Theme.font-size;
                                                color: Theme.text-primary;
                                                horizontal-alignment: Locale.start;
                                                wrap: word-wrap;
                                                height: self.preferred-height;
                                            }
                                        }
                                    }

                                    new-comment := TextArea {
                                        placeholder: @tr("Add a comment");
                                        enabled: root.editable;
                                        accessible-label: @tr("New comment");
                                    }

                                    HorizontalLayout {
                                        alignment: end;

                                        TextButton {
                                            // Translators: a button that adds the comment typed above.
                                            text: @tr("Comment");
                                            enabled: root.editable && new-comment.text != "";
                                            clicked => {
                                                root.comment-add(root.detail-id, new-comment.text);
                                                new-comment.text = "";
                                            }
                                        }
                                    }
                                }

                                if root.detail-meta != "": Hint {
                                    text: root.detail-meta;
                                }
                            }
                        }

                        ScrollBar {
                            x: parent.width - self.width;
                            y: 0px;
                            height: parent.height;
                            content-height: detail-flick.content-height;
                            view-height: detail-flick.height;
                            offset: -detail-flick.content-y;
                            scrolled(offset) => {
                                detail-flick.content-y = -offset;
                            }
                        }
                    }
                }

                if !root.has-detail && root.has-slide: VerticalLayout {
                    padding: 10px;

                    Hint {
                        text: @tr("Select an annotation on the slide or in the list to see its details. Double-click a row to zoom to it; Ctrl+click selects several.");
                    }
                }
            }

            // ---------------- Classes ----------------
            if root.tab == 1: Rectangle {
                classes-flick := Flickable {
                    content-width: self.width;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        padding-right: 12px;
                        spacing: 6px;

                        Hint {
                            text: @tr("New annotations get the active class (●), and the Count tool counts it; Shift+click counts the second class (◐). Pressing a class's hotkey makes it active.");
                        }

                        for c in root.classes: VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: c.active ? Theme.selection : row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item;
                                accessible-label: c.name;
                                accessible-item-selected: c.active;

                                row-touch := TouchArea {
                                    clicked => {
                                        root.class-activate(c.active ? "" : c.id);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 2px;
                                    spacing: 6px;

                                    Text {
                                        width: 14px;
                                        text: c.active ? "●" : c.alternate ? "◐" : "○";
                                        font-size: Theme.font-size;
                                        color: c.active || c.alternate ? Theme.accent-text : Theme.text-disabled;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;

                                        Swatch {
                                            fill: c.color;
                                            label: @tr("Colour of {}", c.name);
                                            clicked(x, y) => {
                                                root.open-palette("class", c.id, x, y);
                                            }
                                        }
                                    }

                                    Text {
                                        text: c.name;
                                        font-size: Theme.font-size;
                                        font-weight: c.active ? 600 : 400;
                                        horizontal-alignment: Locale.start;
                                        color: c.visible ? Theme.text-primary : Theme.text-disabled;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "\{c.count}";
                                        font-size: Theme.small-font-size;
                                        color: Theme.text-secondary;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;

                                        KeyField {
                                            value: c.hotkey;
                                            refused: c.hotkey-note != "";
                                            chosen(key) => {
                                                root.class-hotkey(c.id, key);
                                            }
                                        }
                                    }

                                    IconButton {
                                        icon: c.visible ? @image-url("icons/eye.svg") : @image-url("icons/eye-off.svg");
                                        label: c.visible ? @tr("Hide {}", c.name) : @tr("Show {}", c.name);
                                        tint: c.visible ? Theme.text-primary : Theme.text-disabled;
                                        clicked => {
                                            root.class-visible(c.id, !c.visible);
                                        }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/more.svg");
                                        label: @tr("Class settings");
                                        active: root.editing-class == c.id;
                                        clicked => {
                                            root.editing-class = root.editing-class == c.id ? "" : c.id;
                                        }
                                    }
                                }
                            }

                            if c.hotkey-note != "": HorizontalLayout {
                                padding-left: 28px;

                                Text {
                                    text: c.hotkey-note;
                                    font-size: Theme.small-font-size;
                                    color: Theme.warning;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }

                            if root.editing-class == c.id: Rectangle {
                                border-radius: 4px;
                                background: Theme.surface-raised;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 6px;

                                        Label {
                                            text: @tr("Name");
                                        }

                                        CommitField {
                                            owner: c.id;
                                            value: c.name;
                                            placeholder: @tr("Class name");
                                            accessible-label: @tr("Class name");
                                            committed(owner, text) => {
                                                root.class-rename(owner, text);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        Label {
                                            text: @tr("Opacity");
                                        }

                                        Slider {
                                            value: c.opacity;
                                            label: @tr("Class opacity");
                                            released(value) => {
                                                root.class-opacity(c.id, value);
                                            }
                                        }
                                    }

                                    ButtonFlow {
                                        align-end: true;
                                        buttons: [
                                            {
                                                text: c.alternate ? @tr("Stop counting with Shift+click") : @tr("Count with Shift+click"),
                                                enabled: true,
                                                primary: false,
                                                danger: false,
                                            },
                                            { text: @tr("Delete…"), enabled: true, primary: false, danger: true },
                                        ];
                                        clicked(index) => {
                                            if index == 0 {
                                                root.class-alternate(c.alternate ? "" : c.id);
                                            } else {
                                                root.editing-class = "";
                                                root.class-delete(c.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: start;

                            TextButton {
                                text: @tr("New class");
                                clicked => {
                                    root.class-new();
                                }
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width;
                    y: 0px;
                    height: parent.height;
                    content-height: classes-flick.content-height;
                    view-height: classes-flick.height;
                    offset: -classes-flick.content-y;
                    scrolled(offset) => {
                        classes-flick.content-y = -offset;
                    }
                }
            }

            // ---------------- Count ----------------
            if root.tab == 2: Rectangle {
                count-flick := Flickable {
                    content-width: self.width;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        padding-right: 12px;
                        spacing: 8px;

                        Hint {
                            text: @tr("Pick the Count tool (C) and click cells; Shift+click and Alt+click count the second and third class. Select regions or HPF fields to count inside them.");
                        }

                        ButtonFlow {
                            buttons: [
                                { text: @tr("Count tool (C)"), enabled: root.editable, primary: true, danger: false },
                                { text: @tr("HPF field (H)"), enabled: root.editable, primary: false, danger: false },
                            ];
                            clicked(index) => {
                                root.tool(index == 0 ? "count" : "field");
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                // Translators: the class a click with the Count tool counts.
                                text: @tr("Click");
                                min-width: 80px;
                            }

                            ChoiceButton {
                                text: root.class-names[root.count-active-index];
                                accessible-label: @tr("Class counted by a click");
                                open(x, y, w) => {
                                    root.open-list("count-active", root.class-names, root.count-active-index, x, y, w);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Shift+click");
                                min-width: 80px;
                            }

                            ChoiceButton {
                                text: root.count-alternate-index == 0 ? @tr("(same as click)") : root.class-names[root.count-alternate-index];
                                accessible-label: @tr("Class counted by Shift+click");
                                open(x, y, w) => {
                                    root.open-list("count-alternate", root.class-names, root.count-alternate-index, x, y, w);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Alt+click");
                                min-width: 80px;
                            }

                            ChoiceButton {
                                text: root.count-immune-index == 0 ? @tr("(none)") : root.class-names[root.count-immune-index];
                                accessible-label: @tr("Class counted by Alt+click: PD-L1-positive immune cells for the combined positive score");
                                open(x, y, w) => {
                                    root.open-list("count-immune", root.class-names, root.count-immune-index, x, y, w);
                                }
                            }
                        }

                        if root.count-immune-index != 0: Hint {
                            text: @tr("Combined positive score: the click and Alt+click classes (PD-L1-positive tumour cells and PD-L1-positive immune cells) per 100 tumour cells (the click and Shift+click classes).");
                        }

                        Separator { }

                        if root.has-slide: Text {
                            text: root.count-scope;
                            font-size: Theme.font-size;
                            color: Theme.text-primary;
                            horizontal-alignment: Locale.start;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }

                        if root.has-slide && root.tally.length == 0: Hint {
                            text: @tr("Nothing counted here yet.");
                        }

                        for t in root.tally: VerticalLayout {
                            spacing: 1px;

                            HorizontalLayout {
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: t.color;
                                    }
                                }

                                Text {
                                    text: t.name;
                                    font-size: Theme.font-size;
                                    color: Theme.text-primary;
                                    horizontal-alignment: Locale.start;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: t.count;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    horizontal-alignment: Locale.end;
                                }
                            }

                            if t.density != "" || t.per-hpf != "": HorizontalLayout {
                                padding-left: 16px;

                                Text {
                                    text: t.density + (t.density != "" && t.per-hpf != "" ? " · " : "") + t.per-hpf;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }
                        }

                        if root.count-index != "": Rectangle {
                            border-radius: 4px;
                            background: Theme.info-surface;

                            VerticalLayout {
                                padding: 6px;

                                Text {
                                    text: root.count-index;
                                    font-size: Theme.font-size;
                                    color: Theme.text-primary;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }
                        }

                        Check {
                            text: @tr("Count points in hidden layers");
                            checked: root.count-hidden;
                            toggled(value) => {
                                root.count-hidden-toggled(value);
                            }
                        }

                        HorizontalLayout {
                            alignment: start;

                            TextButton {
                                text: @tr("Clear counts…");
                                danger: true;
                                enabled: root.editable;
                                clicked => {
                                    root.count-clear();
                                }
                            }
                        }

                        Separator { }

                        SectionTitle {
                            text: @tr("HIGH-POWER FIELDS");
                        }

                        Text {
                            text: root.field-text;
                            font-size: Theme.font-size;
                            color: Theme.text-primary;
                            horizontal-alignment: Locale.start;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }

                        ChoiceButton {
                            text: root.field-modes[root.local-field-mode];
                            accessible-label: @tr("How the field size is given");
                            open(x, y, w) => {
                                root.open-list("field-mode", root.field-modes, root.local-field-mode, x, y, w);
                            }
                        }

                        if root.local-field-mode == 0: HorizontalLayout {
                            spacing: 6px;

                            Label {
                                // Translators: FN is the eyepiece's field number, the diameter of the field of view.
                                text: @tr("FN (mm)");
                                min-width: 0px;
                            }

                            fn-field := PlainField {
                                text: root.field-number;
                                placeholder: "22";
                                accessible-label: @tr("Field number in mm");
                                accepted => {
                                    root.field-config(0, fn-field.text, objective-field.text, "");
                                }
                            }

                            Label {
                                // Translators: the magnification of the objective, as in 40×.
                                text: @tr("Objective ×");
                                // The row is not mirrored right to left, where the label is
                                // read after the field number on its left: kept apart from that
                                // field, it stays with its own (its text hugs it).
                                min-width: Locale.rtl ? self.preferred-width + 12px : 0px;
                            }

                            objective-field := PlainField {
                                text: root.field-objective;
                                placeholder: "40";
                                accessible-label: @tr("Objective magnification");
                                accepted => {
                                    root.field-config(0, fn-field.text, objective-field.text, "");
                                }
                            }

                            TextButton {
                                text: @tr("Apply");
                                clicked => {
                                    root.field-config(0, fn-field.text, objective-field.text, "");
                                }
                            }
                        }

                        if root.local-field-mode == 1: HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Area (mm²)");
                                min-width: 0px;
                            }

                            area-field := PlainField {
                                text: root.field-area;
                                placeholder: "0.237";
                                accessible-label: @tr("Field area in square millimetres");
                                accepted => {
                                    root.field-config(1, "", "", area-field.text);
                                }
                            }

                            TextButton {
                                text: @tr("Apply");
                                clicked => {
                                    root.field-config(1, "", "", area-field.text);
                                }
                            }
                        }

                        // The number of fields with "Select all fields" beside
                        // it, or under it when the line is too short for both.
                        Rectangle {
                            property <bool> one-line: fields-placed.preferred-width + 6px + select-fields.min-width <= self.width;
                            property <length> text-height: fields-placed.preferred-height;

                            height: self.one-line ? max(24px, self.text-height) : self.text-height + 6px + 24px;

                            fields-placed := Text {
                                x: 0px;
                                y: 0px;
                                width: parent.one-line ? max(0px, parent.width - select-fields.width - 6px) : parent.width;
                                height: parent.one-line ? max(24px, parent.text-height) : parent.text-height;
                                text: @tr("{n} field placed on this slide." | "{n} fields placed on this slide." % root.field-count);
                                font-size: Theme.font-size;
                                color: Theme.text-secondary;
                                horizontal-alignment: Locale.start;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            select-fields := TextButton {
                                x: parent.width - self.width;
                                y: parent.one-line ? (parent.height - self.height) / 2 : parent.text-height + 6px;
                                width: min(self.min-width, parent.width);
                                text: @tr("Select all fields");
                                enabled: root.field-count > 0;
                                clicked => {
                                    root.fields-select();
                                }
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width;
                    y: 0px;
                    height: parent.height;
                    content-height: count-flick.content-height;
                    view-height: count-flick.height;
                    offset: -count-flick.content-y;
                    scrolled(offset) => {
                        count-flick.content-y = -offset;
                    }
                }
            }

            // ---------------- Data ----------------
            if root.tab == 3: Rectangle {
                data-flick := Flickable {
                    content-width: self.width;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        padding-right: 12px;
                        spacing: 8px;

                        SectionTitle {
                            text: @tr("IMPORT AND EXPORT");
                        }

                        Hint {
                            text: @tr("Imports: GeoJSON (QuPath and others), eov JSON, ASAP XML, Aperio ImageScope XML, Hamamatsu NDPA and DICOM bulk annotations. Coordinates are level-0 pixels with y pointing down.");
                        }

                        // Rows of buttons continue on a second line when the
                        // language's words do not fit on one.
                        ButtonFlow {
                            buttons: [
                                { text: @tr("Import…"), enabled: root.editable, primary: true, danger: false },
                                { text: "GeoJSON…", enabled: root.has-slide, primary: false, danger: false },
                                { text: "eov JSON…", enabled: root.has-slide, primary: false, danger: false },
                                { text: "CSV…", enabled: root.has-slide, primary: false, danger: false },
                            ];
                            clicked(index) => {
                                if index == 0 {
                                    root.menu("import");
                                } else if index == 1 {
                                    root.menu("export-geojson");
                                } else if index == 2 {
                                    root.menu("export-eov");
                                } else {
                                    root.menu("export-csv");
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            TextButton {
                                text: "ASAP XML…";
                                enabled: root.has-slide;
                                clicked => {
                                    root.menu("export-asap");
                                }
                            }

                            TextButton {
                                text: "ImageScope XML…";
                                enabled: root.has-slide;
                                clicked => {
                                    root.menu("export-imagescope");
                                }
                            }

                            TextButton {
                                text: "DICOM…";
                                enabled: root.has-slide;
                                clicked => {
                                    root.menu("export-dicom");
                                }
                            }
                        }

                        ButtonFlow {
                            buttons: [
                                {
                                    // Translators: exports the annotations of every slide in the database to one annotation archive (a JSON file), not the slide images.
                                    text: @tr("Export all slides…"),
                                    enabled: true,
                                    primary: false,
                                    danger: false,
                                },
                                { text: @tr("Back up…"), enabled: true, primary: false, danger: false },
                                { text: @tr("Merge…"), enabled: true, primary: false, danger: false },
                            ];
                            clicked(index) => {
                                if index == 0 {
                                    root.menu("export-all");
                                } else if index == 1 {
                                    root.menu("backup");
                                } else {
                                    root.menu("merge-db");
                                }
                            }
                        }

                        Separator { }

                        SectionTitle {
                            // Translators: a reader is a person who annotates slides; a second reader annotates a blinded copy independently so two readers can be compared (as in a reader study); use the word for an observer or annotator, not the clinical term for a second diagnostic opinion.
                            text: @tr("SECOND READER");
                        }

                        Hint {
                            text: @tr("A blinded copy holds the visible layers' shapes, classes and names, without authors, comments, statuses, descriptions or properties. Compare reads another reader's export and compares it with the visible layers: counts per class, matched points and overlapping regions.");
                        }

                        ButtonFlow {
                            property <[FlowButton]> compare-buttons: [
                                { text: @tr("Blinded copy…"), enabled: root.has-slide, primary: false, danger: false },
                                { text: @tr("Compare…"), enabled: root.has-slide, primary: false, danger: false },
                                {
                                    // Translators: a button: compare with the same file again.
                                    text: @tr("Again"),
                                    enabled: true,
                                    primary: false,
                                    danger: false,
                                },
                                {
                                    // Translators: a button: remove the comparison.
                                    text: @tr("Clear"),
                                    enabled: true,
                                    primary: false,
                                    danger: false,
                                },
                            ];

                            // "Again" and "Clear" once there is a comparison.
                            buttons: root.compare-title != "" ? self.compare-buttons : [self.compare-buttons[0], self.compare-buttons[1]];
                            clicked(index) => {
                                if index == 0 {
                                    root.menu("export-blinded");
                                } else if index == 1 {
                                    root.menu("compare");
                                } else if index == 2 {
                                    root.menu("compare-again");
                                } else {
                                    root.menu("compare-clear");
                                }
                            }
                        }

                        if root.compare-title != "": Text {
                            text: root.compare-title;
                            font-size: Theme.font-size;
                            font-weight: 600;
                            color: Theme.text-primary;
                            horizontal-alignment: Locale.start;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }

                        if root.compare-note != "": Hint {
                            text: root.compare-note;
                        }

                        if root.compare-title != "" && root.compare-rows.length == 0: Hint {
                            text: @tr("Neither reader has points or regions in the compared layers.");
                        }

                        for r in root.compare-rows: VerticalLayout {
                            spacing: 1px;

                            HorizontalLayout {
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: r.color;
                                    }
                                }

                                Text {
                                    text: r.name;
                                    font-size: Theme.font-size;
                                    color: Theme.text-primary;
                                    horizontal-alignment: Locale.start;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            if r.points != "": HorizontalLayout {
                                padding-left: 16px;

                                Text {
                                    text: r.points;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }

                            if r.regions != "": HorizontalLayout {
                                padding-left: 16px;

                                Text {
                                    text: r.regions;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }
                        }

                        Separator { }

                        SectionTitle {
                            text: @tr("DATABASE");
                        }

                        Text {
                            text: root.db-status;
                            font-size: Theme.font-size;
                            color: Theme.text-primary;
                            horizontal-alignment: Locale.start;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }

                        if root.db-path != "": TextInput {
                            text: root.db-path;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            horizontal-alignment: Locale.start;
                            height: self.preferred-height;
                            font-size: Theme.small-font-size;
                            color: Theme.text-secondary;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: #ffffff;
                            accessible-role: text;
                            accessible-label: @tr("Database file");
                        }

                        if root.db-notes != "": Hint {
                            text: root.db-notes;
                        }

                        if root.legacy-db != "": Rectangle {
                            border-radius: 4px;
                            background: Theme.info-surface;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                Text {
                                    // Translators: {} is the path of the old database file.
                                    text: @tr("Annotations made with eov before 1.0 are in {}. Bring them into this database (the old file is not changed):", Locale.isolate(root.legacy-db));
                                    font-size: Theme.font-size;
                                    color: Theme.text-primary;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }

                                HorizontalLayout {
                                    alignment: end;

                                    TextButton {
                                        text: @tr("Bring them in");
                                        primary: true;
                                        clicked => {
                                            root.legacy-merge();
                                        }
                                    }
                                }
                            }
                        }

                        Separator { }

                        HorizontalLayout {
                            spacing: 6px;

                            SectionTitle {
                                text: @tr("OTHER SLIDES");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            TextButton {
                                // Translators: a button that lists the other slides in the database.
                                text: @tr("List");
                                clicked => {
                                    root.orphans-refresh();
                                }
                            }
                        }

                        Hint {
                            text: root.orphans-note;
                        }

                        for o in root.orphans: Rectangle {
                            border-radius: 4px;
                            background: Theme.surface-raised;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: o.title;
                                        font-size: Theme.font-size;
                                        color: Theme.text-primary;
                                        horizontal-alignment: Locale.start;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    TextButton {
                                        // Translators: a button: attach the annotations of this slide to the open slide.
                                        text: @tr("Attach");
                                        enabled: root.editable;
                                        clicked => {
                                            root.orphan-relink(o.id);
                                        }
                                    }
                                }

                                Text {
                                    text: o.detail;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: Locale.start;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }
                        }

                        Separator { }

                        SectionTitle {
                            text: @tr("AUTHOR AND EXPORTS");
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Author");
                                min-width: 84px;
                            }

                            CommitField {
                                owner: "author";
                                value: root.setting-author;
                                placeholder: @tr("Your name or initials");
                                accessible-label: @tr("Author");
                                committed(key, text) => {
                                    root.setting-text(key, text);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Organization");
                                min-width: 84px;
                            }

                            CommitField {
                                owner: "organization";
                                value: root.setting-organization;
                                accessible-label: @tr("Organization");
                                committed(key, text) => {
                                    root.setting-text(key, text);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Project");
                                min-width: 84px;
                            }

                            CommitField {
                                owner: "project";
                                value: root.setting-project;
                                accessible-label: @tr("Project");
                                committed(key, text) => {
                                    root.setting-text(key, text);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("License");
                                min-width: 84px;
                            }

                            CommitField {
                                owner: "license";
                                value: root.setting-license;
                                placeholder: @tr("e.g. CC-BY-4.0");
                                accessible-label: @tr("License");
                                committed(key, text) => {
                                    root.setting-text(key, text);
                                }
                            }
                        }

                        Check {
                            text: @tr("Include the slide's file name in exports");
                            checked: root.setting-include-filename;
                            toggled(value) => {
                                root.setting-bool("include-filename", value);
                            }
                        }

                        Separator { }

                        SectionTitle {
                            text: @tr("DISPLAY");
                        }

                        Check {
                            text: @tr("Show names on the slide");
                            checked: root.setting-show-labels;
                            toggled(value) => {
                                root.setting-bool("show-labels", value);
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Point size");
                                min-width: 84px;
                            }

                            Slider {
                                value: root.setting-point-radius;
                                minimum: 1;
                                maximum: 20;
                                label: @tr("Point size");
                                released(value) => {
                                    root.setting-number("point-radius", value);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                text: @tr("Fill opacity");
                                min-width: 84px;
                            }

                            Slider {
                                value: root.setting-fill-opacity;
                                label: @tr("Fill opacity");
                                released(value) => {
                                    root.setting-number("fill-opacity", value);
                                }
                            }
                        }

                        Separator { }

                        SectionTitle {
                            // Translators: S is the brush tool's key.
                            text: @tr("BRUSH (S)");
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Label {
                                // Translators: the size of the brush.
                                text: @tr("Size");
                                min-width: 84px;
                            }

                            Slider {
                                value: root.setting-brush-size;
                                minimum: 4;
                                maximum: 200;
                                label: @tr("Brush size");
                                released(value) => {
                                    root.setting-number("brush-size", value);
                                }
                            }

                            Text {
                                text: "\{round(root.setting-brush-size)} px";
                                font-size: Theme.small-font-size;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                min-width: 44px;
                            }
                        }

                        Check {
                            text: @tr("Erase from the selected region");
                            checked: root.setting-brush-eraser;
                            toggled(value) => {
                                root.setting-bool("brush-eraser", value);
                            }
                        }

                        Hint {
                            text: @tr("Paint over a selected region to extend it, elsewhere to make a new one. Hold Alt to erase; [ and ] change the size.");
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width;
                    y: 0px;
                    height: parent.height;
                    content-height: data-flick.content-height;
                    view-height: data-flick.height;
                    offset: -data-flick.content-y;
                    scrolled(offset) => {
                        data-flick.content-y = -offset;
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------
    // Popups, drawn over everything.
    // ---------------------------------------------------------------
    if root.popup != 0: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        TouchArea {
            clicked => {
                root.popup = 0;
            }
        }

        if root.popup == 1: Rectangle {
            property <length> list-height: min(root.popup-items.length * 24px + 8px, root.height - 16px);
            property <bool> above: root.popup-y + self.list-height > root.height - 4px;

            x: clamp(root.popup-x-is-end ? root.popup-x - self.width : root.popup-x, 4px, max(4px, root.width - self.width - 4px));
            y: self.above ? max(4px, root.popup-y - self.list-height - 26px) : root.popup-y + 2px;
            // As wide as the widest item (whose length depends on the
            // language), within the panel.
            width: min(max(max(root.popup-w, 150px), popup-items-layout.preferred-width), root.width - 8px);
            height: self.list-height;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface-raised;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000090;
            clip: true;
            accessible-role: list;

            // Swallow clicks between items.
            TouchArea { }

            popup-flick := Flickable {
                content-width: self.width;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                popup-items-layout := VerticalLayout {
                    alignment: start;
                    padding: 4px;

                    for item[i] in root.popup-items: Rectangle {
                        height: 24px;
                        border-radius: 3px;
                        background: item-touch.has-hover ? Theme.accent : i == root.popup-current ? Theme.selection : transparent;
                        accessible-role: list-item;
                        accessible-label: item;
                        accessible-item-selected: i == root.popup-current;
                        accessible-action-default => {
                            root.choose(i);
                        }

                        // In a layout, so that the list knows the item's width.
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: item;
                                font-size: Theme.font-size;
                                color: item-touch.has-hover ? #ffffff : Theme.text-primary;
                                horizontal-alignment: Locale.start;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        item-touch := TouchArea {
                            clicked => {
                                root.choose(i);
                            }
                        }
                    }
                }
            }
        }

        if root.popup == 2: Rectangle {
            property <length> cell: 26px;

            x: clamp(root.popup-x - 4px, 4px, max(4px, root.width - self.width - 4px));
            y: root.popup-y + 2px + self.height > root.height - 4px ? max(4px, root.popup-y - self.height - 22px) : root.popup-y + 2px;
            width: 8 * self.cell + 12px;
            height: 2 * self.cell + 12px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface-raised;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000090;
            accessible-role: list;
            accessible-label: @tr("Colours");

            TouchArea { }

            for p[i] in root.palette: Rectangle {
                x: 6px + mod(i, 8) * parent.cell;
                y: 6px + floor(i / 8) * parent.cell;
                width: parent.cell;
                height: parent.cell;
                accessible-role: button;
                accessible-label: p.hex;
                accessible-action-default => {
                    root.pick-color(p.hex);
                }

                Rectangle {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    border-radius: 4px;
                    border-width: swatch-touch.has-hover ? 2px : 1px;
                    border-color: swatch-touch.has-hover ? #ffffff : #ffffff30;
                    background: p.color;
                }

                swatch-touch := TouchArea {
                    clicked => {
                        root.pick-color(p.hex);
                    }
                }
            }
        }
    }
}
