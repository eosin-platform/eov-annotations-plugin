// Colours of eov's dark theme.
export global Theme {
    out property <color> background: #1e1e1e;
    out property <color> surface: #252526;
    out property <color> surface-raised: #2d2d30;
    out property <color> surface-hover: #2f3236;
    out property <color> input: #15191e;
    out property <color> border: #3e3e42;
    out property <color> border-strong: #5a5a60;
    out property <color> text-primary: #d4d4d4;
    out property <color> text-secondary: #9a9a9a;
    out property <color> text-disabled: #5f5f5f;
    out property <color> accent: #0e639c;
    out property <color> accent-hover: #1177bb;
    out property <color> accent-text: #6cb6ff;
    out property <color> selection: #4da3d933;
    out property <color> hover: #ffffff10;
    out property <color> warning: #e5a50a;
    out property <color> warning-surface: #3b3218;
    out property <color> error: #f44336;
    out property <color> error-surface: #3d1f1f;
    out property <color> info-surface: #1c2b3a;
    out property <color> success: #4caf50;
    out property <length> row-height: 26px;
    out property <length> font-size: 12px;
    out property <length> small-font-size: 11px;
}
