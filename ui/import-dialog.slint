// Preview of an import: what was read, whether it was made for this slide,
// what had to be skipped or repaired, and what to do with layers whose
// names already exist. Nothing is written until "Import" is pressed.

import { Theme } from "theme.slint";
import { Locale } from "locale.slint";

// For tools/ui-check, which checks that `eov-rtl` reaches it.
export { Locale }
import { TextButton, SectionTitle, Hint, Separator, ScrollBar } from "widgets.slint";

component Choice inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> selected;
    callback clicked();

    border-radius: 4px;
    background: root.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: root.selected ? Theme.accent-text : Theme.border-strong;
                    background: Theme.input;

                    if root.selected: Rectangle {
                        x: 3px;
                        y: 3px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.accent-text;
                    }
                }
            }

            Text {
                text: root.text;
                font-size: Theme.font-size;
                color: Theme.text-primary;
                horizontal-alignment: Locale.start;
                horizontal-stretch: 1;
            }
        }

        // One child per horizontal layout: Slint then sizes wrapped text
        // correctly.
        HorizontalLayout {
            padding-left: 22px;

            Text {
                text: root.detail;
                font-size: Theme.small-font-size;
                color: Theme.text-secondary;
                horizontal-alignment: Locale.start;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
    }
}

export component ImportDialog inherits Rectangle {
    in property <string> source;
    in property <string> summary;
    in property <string> match-text;
    in property <bool> mismatch;
    in property <string> notes;
    in property <string> conflicts;
    // Why nothing can be imported ("" when the file can be).
    in property <string> blocked;
    // Set by eov: the interface is written from right to left.
    in-out property <bool> eov-rtl <=> Locale.rtl;
    // Set by eov: the language of the interface (a tag such as "pt-BR").
    in property <string> eov-language;
    changed eov-language => {
        Locale.language = root.eov-language;
    }

    // 0 merge, 1 replace, 2 keep both
    callback import-confirm(int /* strategy */);
    callback import-cancel();

    property <int> strategy: 0;

    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: @tr("Import annotations");

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: @tr("Import annotations");
            font-size: 15px;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: Locale.start;
        }

        Rectangle {
            vertical-stretch: 1;

            flick := Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    padding-right: 10px;

                    Text {
                        text: root.source;
                        font-size: Theme.font-size;
                        color: Theme.text-primary;
                        horizontal-alignment: Locale.start;
                        wrap: word-wrap;
                        height: self.preferred-height;
                    }

                    Text {
                        text: root.summary;
                        font-size: Theme.font-size;
                        color: Theme.text-secondary;
                        horizontal-alignment: Locale.start;
                        wrap: word-wrap;
                        height: self.preferred-height;
                    }

                    Rectangle {
                        border-radius: 4px;
                        background: root.mismatch ? Theme.warning-surface : Theme.info-surface;

                        VerticalLayout {
                            padding: 8px;

                            Text {
                                text: root.match-text;
                                font-size: Theme.font-size;
                                color: root.mismatch ? #ffd88a : Theme.text-primary;
                                horizontal-alignment: Locale.start;
                                wrap: word-wrap;
                                height: self.preferred-height;
                            }
                        }
                    }

                    if root.notes != "": VerticalLayout {
                        spacing: 4px;

                        SectionTitle {
                            text: @tr("NOTES");
                        }

                        Text {
                            text: root.notes;
                            font-size: Theme.small-font-size;
                            color: Theme.text-secondary;
                            horizontal-alignment: Locale.start;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }
                    }

                    if root.conflicts != "": VerticalLayout {
                        spacing: 4px;

                        Separator { }

                        Text {
                            text: root.conflicts;
                            font-size: Theme.font-size;
                            color: Theme.text-primary;
                            horizontal-alignment: Locale.start;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }

                        Choice {
                            text: @tr("Add to the existing layers");
                            detail: @tr("Imported annotations join the layer with the same name.");
                            selected: root.strategy == 0;
                            clicked => {
                                root.strategy = 0;
                            }
                        }

                        Choice {
                            text: @tr("Replace the existing layers");
                            detail: @tr("The existing layers are deleted (this can be undone).");
                            selected: root.strategy == 1;
                            clicked => {
                                root.strategy = 1;
                            }
                        }

                        Choice {
                            text: @tr("Keep both");
                            // Translators: "Tumour" is only an example of a layer name from the imported file: translate it, and keep the " (2)" that eov adds.
                            detail: @tr("Imported layers get a new name, such as \"Tumour (2)\".");
                            selected: root.strategy == 2;
                            clicked => {
                                root.strategy = 2;
                            }
                        }
                    }

                    if root.blocked == "": Hint {
                        text: @tr("The import is one step: Ctrl+Z (⌘Z) removes everything it added.");
                    }
                }
            }

            ScrollBar {
                x: parent.width - self.width;
                y: 0px;
                height: parent.height;
                content-height: flick.content-height;
                view-height: flick.height;
                offset: -flick.content-y;
                scrolled(offset) => {
                    flick.content-y = -offset;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            TextButton {
                text: root.blocked != "" ? @tr("Close") : @tr("Cancel");
                clicked => {
                    root.import-cancel();
                }
            }

            if root.blocked == "": TextButton {
                text: root.mismatch ? @tr("Import anyway") : @tr("Import");
                primary: !root.mismatch;
                danger: root.mismatch;
                clicked => {
                    root.import-confirm(root.strategy);
                }
            }
        }
    }
}
