msgstr ""
"इस स्लाइड पर अभी कोई HPF फ़ील्ड नहीं है। उन्हें रखने के लिए HPF फ़ील्ड टूल (H) का उपयोग "
"करें।"

#: src/actions.rs:960
msgid "Repair outline"
msgstr "रूपरेखा सुधारना"

#: src/actions.rs:975
msgid "Nothing is left of the outline."
msgstr "रूपरेखा का कुछ भी शेष नहीं बचा।"

#. Translators: {n} is 2 or more.
#: src/actions.rs:997
msgid "The outline was split into {n} parts."
msgid_plural "The outline was split into {n} parts."
msgstr[0] "रूपरेखा को {n} भाग में विभाजित किया गया।"
msgstr[1] "रूपरेखा को {n} भागों में विभाजित किया गया।"

