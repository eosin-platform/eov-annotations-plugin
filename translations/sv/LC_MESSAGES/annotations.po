#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Annoteringar"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Punkt-, områdes-, linje- och textannoteringar med återanvändbara klasser, "
"cellräkning, HPF-fält och mätningar; import och export av GeoJSON (QuPath), "
"import av ASAP och Aperio ImageScope XML."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"Annoteringarna för det här preparatet läses fortfarande in; försök igen om "
"en stund."

