#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Annotazioni"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Annotazioni di punti, regioni, linee e testo con classi riutilizzabili, "
"conteggio cellulare, campi HPF e misurazioni; importazione ed esportazione "
"GeoJSON (QuPath), importazione XML di ASAP e Aperio ImageScope."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"Le annotazioni di questo vetrino sono ancora in caricamento; riprova tra "
"poco."

