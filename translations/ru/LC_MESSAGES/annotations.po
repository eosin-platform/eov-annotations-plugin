msgid_plural "{n} holes {regions} (drawn without them)"
msgstr[0] "{n} отверстие {regions} (области отображаются без отверстий)"
msgstr[1] "{n} отверстия {regions} (области отображаются без отверстий)"
msgstr[2] "{n} отверстий {regions} (области отображаются без отверстий)"

