#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Anotaciones"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Anotaciones de puntos, regiones, líneas y texto con clases reutilizables, "
"recuento celular, campos HPF y mediciones; importación y exportación GeoJSON "
"(QuPath), e importación XML de ASAP y Aperio ImageScope."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"Las anotaciones de esta preparación aún se están cargando; vuelva a "
"intentarlo en un momento."

