msgstr "anotasi telah diubah di tempat lain sementara itu"

#: src/core.rs:971
msgid "the layer was changed elsewhere in the meantime"
msgstr "lapisan telah diubah di tempat lain sementara itu"

#: src/core.rs:972
msgid "the class was changed elsewhere in the meantime"
msgstr "kelas telah diubah di tempat lain sementara itu"

#: src/core.rs:973
msgid "a layer being moved was changed elsewhere in the meantime"
msgstr ""
"lapisan yang sedang dipindahkan telah diubah di tempat lain sementara itu"

#: src/core.rs:1053
msgid "Could not save \"{}\""
msgstr "Tidak dapat menyimpan “{}”"

#: src/core.rs:1123
msgid "This annotation change can no longer be undone."
msgstr "Perubahan anotasi ini tidak dapat diurungkan lagi."

#: src/core.rs:1137
