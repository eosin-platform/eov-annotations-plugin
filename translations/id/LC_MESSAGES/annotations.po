#: ui/annotations-sidebar.slint:1885
msgctxt "AnnotationsSidebar"
msgid "Select all fields"
msgstr "Pilih semua lapang pandang"

#: ui/annotations-sidebar.slint:1924
msgctxt "AnnotationsSidebar"
msgid "IMPORT AND EXPORT"
msgstr "IMPOR DAN EKSPOR"

#: ui/annotations-sidebar.slint:1928
msgctxt "AnnotationsSidebar"
msgid ""
"Imports: GeoJSON (QuPath and others), eov JSON, ASAP XML, Aperio ImageScope "
"XML, Hamamatsu NDPA and DICOM bulk annotations. Coordinates are level-0 "
"pixels with y pointing down."
msgstr ""
"Impor: GeoJSON (QuPath dan lainnya), eov JSON, ASAP XML, Aperio ImageScope "
"XML, Hamamatsu NDPA, dan anotasi massal DICOM. Koordinat berupa piksel level "
"0 dengan sumbu y mengarah ke bawah."

#: ui/annotations-sidebar.slint:1935
msgctxt "AnnotationsSidebar"
msgid "Import…"
msgstr "Impor…"

#: ui/annotations-sidebar.slint:1991
msgctxt "AnnotationsSidebar"
msgid "Back up…"
msgstr "Cadangkan…"

#: ui/annotations-sidebar.slint:1992
msgctxt "AnnotationsSidebar"
msgid "Merge…"
msgstr "Gabungkan…"

#. Translators: a reader is a person who annotates slides; a second reader
#. annotates a blinded copy independently so two readers can be compared (as
#. in a reader study); use the word for an observer or annotator, not the
#. clinical term for a second diagnostic opinion.
#: ui/annotations-sidebar.slint:2009
msgctxt "AnnotationsSidebar"
msgid "SECOND READER"
msgstr "PEMBACA KEDUA"

#: ui/annotations-sidebar.slint:2013
msgctxt "AnnotationsSidebar"
msgid ""
"A blinded copy holds the visible layers' shapes, classes and names, without "
"authors, comments, statuses, descriptions or properties. Compare reads "
"another reader's export and compares it with the visible layers: counts per "
"class, matched points and overlapping regions."
msgstr ""
"Salinan tersamar berisi bentuk, kelas, dan nama dari lapisan yang terlihat, "
"tanpa penulis, komentar, status, deskripsi, atau properti. Tombol Bandingkan "
"membaca hasil ekspor pembaca lain dan membandingkannya dengan lapisan yang "
"terlihat: hitungan per kelas, titik yang cocok, dan area yang tumpang tindih."

#: ui/annotations-sidebar.slint:2018
msgctxt "AnnotationsSidebar"
msgid "Blinded copy…"
msgstr "Salinan tersamar…"

#: ui/annotations-sidebar.slint:2019
msgctxt "AnnotationsSidebar"
msgid "Compare…"
msgstr "Bandingkan…"

#. Translators: a button: compare with the same file again.
#: ui/annotations-sidebar.slint:2022
msgctxt "AnnotationsSidebar"
msgid "Again"
msgstr "Ulangi"

#. Translators: a button: remove the comparison.
#: ui/annotations-sidebar.slint:2029
msgctxt "AnnotationsSidebar"
msgid "Clear"
msgstr "Hapus"

#: ui/annotations-sidebar.slint:2066
msgctxt "AnnotationsSidebar"
msgid "Neither reader has points or regions in the compared layers."
msgstr ""
"Tidak ada pembaca yang memiliki titik atau area di lapisan yang dibandingkan."

