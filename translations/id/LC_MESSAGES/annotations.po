#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Anotasi"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Anotasi titik, area, garis, dan teks dengan kelas yang dapat digunakan "
"ulang, hitung sel, lapang pandang HPF, dan pengukuran; impor dan ekspor "
"GeoJSON (QuPath), impor XML ASAP dan Aperio ImageScope."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr "Anotasi preparat ini masih dimuat; coba kembali sebentar lagi."

#: src/actions.rs:27 src/sidebar.rs:1390 src/sidebar.rs:1474
msgid "That layer no longer exists."
msgstr "Lapisan tersebut sudah tidak ada."

#: src/actions.rs:31
msgid "That annotation no longer exists."
msgstr "Anotasi tersebut sudah tidak ada."

#: src/actions.rs:35 src/sidebar.rs:1605
