msgstr "{} /10 HPF"

#: src/counting.rs:222
msgid "100 (capped; the ratio is higher)"
msgstr "100 (begrensd; de verhouding is hoger)"

#. Translators: CPS is the PD-L1 combined positive score; {positive},
#. {negative} and {immune} are names of classes of cells.
#: src/counting.rs:234
