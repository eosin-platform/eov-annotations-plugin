"CPS {score} — ({a} {positive} + {c} {immune}) per {n} tumour cells "
"({positive} + {negative}) × 100."
msgstr[0] ""
"CPS {score} — ({a} {positive} + {c} {immune}) per {n} tumorcel ({positive} + "
"{negative}) × 100."
msgstr[1] ""
"CPS {score} — ({a} {positive} + {c} {immune}) per {n} tumorcellen "
"({positive} + {negative}) × 100."

#: src/counting.rs:248
msgid "Fewer than {n} tumour cells: below the minimum for a valid score."
msgid_plural ""
"Fewer than {n} tumour cells: below the minimum for a valid score."
msgstr[0] "Minder dan {n} tumorcel: onder het minimum voor een geldige score."
msgstr[1] ""
"Minder dan {n} tumorcellen: onder het minimum voor een geldige score."

#. Translators: e.g. "Ki-67+ index: 25.0 % (95% 20.1–30.4 %) — 25 of 100 (Ki-67+ + Ki-67-)";
