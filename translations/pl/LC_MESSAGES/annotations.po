#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Adnotacje"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Adnotacje punktowe, obszarowe, liniowe i tekstowe z klasami wielokrotnego "
"użytku, zliczanie komórek, pola HPF i pomiary; import i eksport GeoJSON "
"(QuPath), import XML z ASAP i Aperio ImageScope."

