msgctxt "AnnotationsSidebar"
msgid "Colours"
msgstr "Kolory"

#: ui/import-dialog.slint:117 ui/import-dialog.slint:124
msgctxt "ImportDialog"
msgid "Import annotations"
msgstr "Import adnotacji"

#: ui/import-dialog.slint:186
msgctxt "ImportDialog"
msgid "NOTES"
msgstr "UWAGI"

#: ui/import-dialog.slint:214
msgctxt "ImportDialog"
msgid "Add to the existing layers"
msgstr "Dodaj do istniejących warstw"

#: ui/import-dialog.slint:215
msgctxt "ImportDialog"
msgid "Imported annotations join the layer with the same name."
msgstr "Zaimportowane adnotacje trafiają do warstwy o tej samej nazwie."

#: ui/import-dialog.slint:223
msgctxt "ImportDialog"
msgid "Replace the existing layers"
msgstr "Zastąp istniejące warstwy"

#: ui/import-dialog.slint:224
msgctxt "ImportDialog"
msgid "The existing layers are deleted (this can be undone)."
msgstr "Istniejące warstwy zostaną usunięte (można to cofnąć)."

#: ui/import-dialog.slint:232
msgctxt "ImportDialog"
msgid "Keep both"
msgstr "Zachowaj obie"

#. Translators: "Tumour" is only an example of a layer name from the imported
#. file: translate it, and keep the " (2)" that eov adds.
#: ui/import-dialog.slint:234
msgctxt "ImportDialog"
msgid "Imported layers get a new name, such as \"Tumour (2)\"."
msgstr "Zaimportowane warstwy otrzymają nową nazwę, np. „Nowotwór (2)”."

#: ui/import-dialog.slint:243
msgctxt "ImportDialog"
msgid "The import is one step: Ctrl+Z (⌘Z) removes everything it added."
msgstr "Import jest jednym krokiem: Ctrl+Z (⌘Z) usuwa wszystko, co dodał."

#: ui/import-dialog.slint:266
msgctxt "ImportDialog"
msgid "Cancel"
msgstr "Anuluj"

#: ui/import-dialog.slint:266
msgctxt "ImportDialog"
msgid "Close"
msgstr "Zamknij"

#: ui/import-dialog.slint:273
msgctxt "ImportDialog"
msgid "Import"
msgstr "Importuj"

#: ui/import-dialog.slint:273
msgctxt "ImportDialog"
msgid "Import anyway"
msgstr "Importuj mimo to"

#: ui/widgets.slint:655
msgctxt "Swatch"
msgid "Change colour"
msgstr "Zmień kolor"

#: ui/widgets.slint:694
msgctxt "KeyField"
msgid "Hotkey"
msgstr "Skrót klawiaturowy"

#: ui/widgets.slint:696
msgctxt "KeyField"
msgid "Click, then press a key. Backspace removes the hotkey."
msgstr "Kliknij, a następnie naciśnij klawisz. Backspace usuwa skrót."
