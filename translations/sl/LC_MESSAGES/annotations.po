msgstr[0] "konica {n} puščice (zapisana kot črte)"
msgstr[1] "konici {n} puščic (zapisani kot črte)"
msgstr[2] "konice {n} puščic (zapisane kot črte)"
msgstr[3] "konice {n} puščic (zapisane kot črte)"

