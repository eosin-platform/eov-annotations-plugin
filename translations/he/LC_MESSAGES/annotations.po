#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "סימונים"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"סימוני נקודות, אזורים, קווים וטקסט עם קטגוריות לשימוש חוזר, ספירת תאים, שדות "
"HPF ומדידות; ייבוא וייצוא של GeoJSON (QuPath), וייבוא XML של ASAP ושל Aperio "
"ImageScope."

