msgid_plural "Attached {n} layers to this slide."
msgstr[0] "Προσαρτήθηκε {n} στρώση σε αυτό το πλακίδιο."
msgstr[1] "Προσαρτήθηκαν {n} στρώσεις σε αυτό το πλακίδιο."

#: src/actions.rs:1076
msgid "New class"
msgstr "Νέα κατηγορία"

#: src/actions.rs:1138
msgid "Rename class"
msgstr "Μετονομασία κατηγορίας"

