msgstr ""
"Δεν υπάρχουν ακόμη πεδία HPF σε αυτό το πλακίδιο. Χρησιμοποιήστε το εργαλείο "
"πεδίου HPF (H) για να τα τοποθετήσετε."

#: src/actions.rs:960
msgid "Repair outline"
msgstr "Επιδιόρθωση περιγράμματος"

#: src/actions.rs:975
msgid "Nothing is left of the outline."
msgstr "Δεν απέμεινε τίποτα από το περίγραμμα."

#. Translators: {n} is 2 or more.
#: src/actions.rs:997
msgid "The outline was split into {n} parts."
msgid_plural "The outline was split into {n} parts."
msgstr[0] "Το περίγραμμα χωρίστηκε σε {n} μέρος."
msgstr[1] "Το περίγραμμα χωρίστηκε σε {n} μέρη."

#: src/actions.rs:1012
msgid "Could not attach the annotations"
