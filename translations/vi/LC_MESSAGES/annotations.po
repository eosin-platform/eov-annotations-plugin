msgid_plural ""
"CPS {score} — ({a} {positive} + {c} {immune}) per {n} tumour cells "
"({positive} + {negative}) × 100."
msgstr[0] ""
"CPS {score} — ({a} {positive} + {c} {immune}) trên {n} tế bào u ({positive} "
"+ {negative}) × 100."

