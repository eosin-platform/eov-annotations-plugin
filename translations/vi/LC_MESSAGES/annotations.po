#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Chú thích"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Chú thích dạng điểm, vùng, đường và văn bản với các loại dùng lại được, đếm "
"tế bào, vi trường HPF và số đo; nhập và xuất GeoJSON (QuPath), nhập XML của "
"ASAP và Aperio ImageScope."

