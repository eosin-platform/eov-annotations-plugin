#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Anotações"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Anotações de pontos, regiões, linhas e textos com classes reutilizáveis, "
"contagem de células, campos HPF e medições; importação e exportação de "
"GeoJSON (QuPath) e importação de XML do ASAP e do Aperio ImageScope."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"As anotações desta lâmina ainda estão sendo carregadas; tente novamente em "
"instantes."

