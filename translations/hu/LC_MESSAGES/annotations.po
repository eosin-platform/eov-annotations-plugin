#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Annotációk"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Pont-, terület-, vonal- és szövegannotációk újrahasználható osztályokkal, "
"sejtszámlálás, HPF-látóterek és mérések; importálás és exportálás GeoJSON "
"(QuPath) formátumban, importálás ASAP és Aperio ImageScope XML-fájlokból."

