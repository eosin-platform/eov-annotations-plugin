msgstr "Importované vrstvy dostanou nový název, například „Nádor (2)“."

#: ui/import-dialog.slint:243
msgctxt "ImportDialog"
msgid "The import is one step: Ctrl+Z (⌘Z) removes everything it added."
msgstr "Import je jeden krok: Ctrl+Z (⌘Z) odebere vše, co přidal."

