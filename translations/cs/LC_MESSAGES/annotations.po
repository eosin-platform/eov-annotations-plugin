#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Anotace"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Bodové, plošné, čárové a textové anotace s opakovaně použitelnými třídami, "
"počítání buněk, pole HPF a měření; import a export GeoJSON (QuPath), import "
"XML z ASAP a Aperio ImageScope."

