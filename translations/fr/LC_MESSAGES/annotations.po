#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Annotations"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Annotations ponctuelles, de régions, de lignes et de texte avec des classes "
"réutilisables, comptage cellulaire, champs HPF et mesures ; importation et "
"exportation GeoJSON (QuPath), importation XML ASAP et Aperio ImageScope."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"Les annotations de cette lame sont encore en cours de chargement ; réessayez "
"dans un instant."

