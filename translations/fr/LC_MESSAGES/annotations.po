msgstr "groupe d'annotations dont la liste d'index de points est illisible"

#: src/formats/dicom/mod.rs:1197
msgid "annotation group with lines or polygons with an empty point index list"
msgstr ""
"groupe d'annotations contenant des lignes ou des polygones avec une liste "
"d'index de points vide"

#: src/formats/dicom/mod.rs:1211
msgid ""
"The point index list of \"{}\" counts points rather than coordinate values; "
"it was read that way."
msgstr ""
"La liste d'index de points de « {} » compte des points plutôt que des "
"valeurs de coordonnées ; elle a été lue ainsi."

#: src/formats/dicom/mod.rs:1217
msgid ""
"annotation group with a point index list that does not fit its coordinates"
msgstr ""
"groupe d'annotations dont la liste d'index de points ne correspond pas à ses "
"coordonnées"

