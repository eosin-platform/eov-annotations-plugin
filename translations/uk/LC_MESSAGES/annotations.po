msgstr[1] ""
"CPS {score} — ({a} {positive} + {c} {immune}) на {n} пухлинні клітини "
"({positive} + {negative}) × 100."
msgstr[2] ""
"CPS {score} — ({a} {positive} + {c} {immune}) на {n} пухлинних клітин "
"({positive} + {negative}) × 100."

#: src/counting.rs:248
msgid "Fewer than {n} tumour cells: below the minimum for a valid score."
msgid_plural ""
"Fewer than {n} tumour cells: below the minimum for a valid score."
msgstr[0] ""
