#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Annotaatiot"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Piste-, alue-, viiva- ja tekstiannotaatiot uudelleenkäytettävine luokkineen, "
"solulaskenta, HPF-kentät ja mittaukset; GeoJSON-tuonti ja -vienti (QuPath) "
"sekä XML-tuonti ASAP- ja Aperio ImageScope -muodoista."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"Tämän näytelasin annotaatioita ladataan vielä; yritä hetken kuluttua "
"uudelleen."

