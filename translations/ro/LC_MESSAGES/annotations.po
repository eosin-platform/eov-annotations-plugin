#: plugin.toml
msgctxt "plugin.toml"
msgid "Annotations"
msgstr "Adnotări"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Point, region, line and text annotations with reusable classes, cell "
"counting, HPF fields and measurements; GeoJSON (QuPath) import and export, "
"ASAP and Aperio ImageScope XML import."
msgstr ""
"Adnotări de tip punct, regiune, linie și text, cu clase reutilizabile, "
"numărarea celulelor, câmpuri HPF și măsurători; import și export GeoJSON "
"(QuPath), import XML ASAP și Aperio ImageScope."

#: src/actions.rs:23
msgid "The annotations of this slide are still loading; try again in a moment."
msgstr ""
"Adnotările acestei lame încă se încarcă; încercați din nou peste câteva "
"momente."

#: src/actions.rs:27 src/sidebar.rs:1390 src/sidebar.rs:1474
msgid "That layer no longer exists."
msgstr "Stratul respectiv nu mai există."

#: src/actions.rs:31
msgid "That annotation no longer exists."
msgstr "Adnotarea respectivă nu mai există."

#: src/actions.rs:35 src/sidebar.rs:1605
msgid "That class no longer exists."
