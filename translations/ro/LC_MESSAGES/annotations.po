msgstr[0] ""
"„{name}” declară {n} adnotare, dar coordonatele sale conțin {held}; s-au "
"citit coordonatele."
msgstr[1] ""
"„{name}” declară {n} adnotări, dar coordonatele sale conțin {held}; s-au "
"citit coordonatele."
msgstr[2] ""
"„{name}” declară {n} de adnotări, dar coordonatele sale conțin {held}; s-au "
"citit coordonatele."

#: src/formats/dicom/mod.rs:1463
msgid ""
"eov's private attributes of \"{}\" are unreadable; the group was read from "
